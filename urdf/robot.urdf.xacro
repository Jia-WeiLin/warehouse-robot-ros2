<?xml version="1.0"?>

<robot name="warehouse_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ====================== -->
    <!-- Base Link              -->
    <!-- ====================== -->

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1.0 0.5 0.2"/>
            </geometry>

            <material name="purple">
                <color rgba="0.5 0.0 0.8 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1.0 0.5 0.2"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="10.0"/>

            <inertia
                ixx="0.2417"
                ixy="0.0"
                ixz="0.0"
                iyy="0.8667"
                iyz="0.0"
                izz="1.0417"/>
        </inertial>

    </link>


    <!-- ====================== -->
    <!-- Camera Link            -->
    <!-- ====================== -->

    <link name="camera_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <box size="0.15 0.12 0.10"/>
            </geometry>

            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.15 0.12 0.10"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>

            <inertia
                ixx="0.0010"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0014"
                iyz="0.0"
                izz="0.0015"/>
        </inertial>

    </link>


    <!-- Camera Joint -->

    <joint name="camera_joint" type="fixed">

        <parent link="base_link"/>
        <child link="camera_link"/>

        <origin xyz="0.30 0 0.15"
                rpy="0 0 0"/>

    </joint>
    


    <!-- ====================== -->
    <!-- Left Wheel             -->
    <!-- ====================== -->

    <link name="left_wheel_link">

        <!-- Wheel -->

        <visual>
            <origin xyz="0 0 0"
                    rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.15"
                          length="0.08"/>
            </geometry>

            <material name="gray">
                <color rgba="0.2 0.2 0.2 1.0"/>
            </material>
        </visual>

        <!-- White Marker -->

        <visual>
            <origin xyz="0.15 0 0"
                    rpy="0 0 0"/>

            <geometry>
                <box size="0.02 0.085 0.03"/>
            </geometry>

            <material name="white_marker">
                <color rgba="1.0 1.0 1.0 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0"
                    rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.15"
                          length="0.08"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0"
                    rpy="0 0 0"/>

            <mass value="1.0"/>

            <inertia
                ixx="0.0062"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0113"
                iyz="0.0"
                izz="0.0062"/>
        </inertial>

    </link>


    <joint name="left_wheel_joint"
           type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel_link"/>

        <origin xyz="-0.1 0.29 -0.15"
                rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ====================== -->
    <!-- Right Wheel            -->
    <!-- ====================== -->

    <link name="right_wheel_link">

        <visual>
            <origin xyz="0 0 0"
                    rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.15"
                          length="0.08"/>
            </geometry>

            <material name="gray"/>
        </visual>

        <!-- White Marker -->

        <visual>
            <origin xyz="0.15 0 0"
                    rpy="0 0 0"/>

            <geometry>
                <box size="0.02 0.085 0.03"/>
            </geometry>

            <material name="white_marker"/>
        </visual>

        <collision>
            <origin xyz="0 0 0"
                    rpy="1.5708 0 0"/>

            <geometry>
                <cylinder radius="0.15"
                          length="0.08"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0"
                    rpy="0 0 0"/>

            <mass value="1.0"/>

            <inertia
                ixx="0.0062"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0113"
                iyz="0.0"
                izz="0.0062"/>
        </inertial>

    </link>


    <joint name="right_wheel_joint"
           type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel_link"/>

        <origin xyz="-0.1 -0.29 -0.15"
                rpy="0 0 0"/>

        <axis xyz="0 1 0"/>
    </joint>
    <link name ="caster_link">
        <visual>
            <geometry>
                <sphere radius="0.15"/>
            </geometry>
         </visual>
         <collision>
            <geometry>
                <sphere radius="0.15"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>

            <inertia
                ixx="0.0002"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0002"
                iyz="0.0"
                izz="0.0002"/>
            </inertial>
    </link>
    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
            <origin xyz="0.4 0 -0.15"/>
          
        <child link="caster_link"/>   
    </joint>
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
             <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>
    </link> 

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 0.30" rpy="0 0 0"/>
    </joint>
    <gazebo reference="lidar_link">

        <sensor name="lidar_sensor" type="gpu_lidar">
            <update_rate>10</update_rate>
            <lidar>
            <scan>
                <horizontal>
                    <samples>360</samples>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.1</min>
                <max>10.0</max>
            </range>
            </lidar>
        </sensor>

    </gazebo>



    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
         <joint name="right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>
    <gazebo>
        <plugin
            filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <parameters>$(find warehouse_robot)/config/controllers.yaml</parameters>

         </plugin>
    </gazebo>

    

</robot>